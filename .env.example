# PostgreSQL Database Connection (Used by both Next.js and Socket.IO server)
DATABASE_URL="postgresql://postgres:password@localhost:5432/our_space?schema=public"

# Session Security Secret (Generate with: openssl rand -hex 32)
SESSION_SECRET="our-space-super-secure-session-secret-key-32chars"

# Frontend Application URL (Used by Socket.IO for CORS validation)
APP_URL="https://sonam.puspender.in"
NEXT_PUBLIC_APP_URL="https://sonam.puspender.in"

# Dedicated Socket.IO Server Public URL (Used by browser frontend)
# Local: http://localhost:3001
# Production: https://socket.puspender.in (or https://<service>.onrender.com)
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# Cookie Configuration for cross-subdomain sharing
# Set to .puspender.in in production when socket is hosted on socket.puspender.in
# Leave unset in local development
# COOKIE_DOMAIN=".puspender.in"
# COOKIE_SAME_SITE="lax"

# Socket Server Listening Port (Default: 3001 locally, assigned by host in cloud like Render/Railway)
PORT=3001

# Storage Configuration (local | s3)
STORAGE_PROVIDER="local"

# S3 / Cloudflare R2 Configuration (required if STORAGE_PROVIDER="s3")
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="our-space-media"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"
