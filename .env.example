# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:password@localhost:5432/our_space?schema=public"

# Session Security Secret (Generate with: openssl rand -hex 32)
SESSION_SECRET="our-space-super-secure-session-secret-key-32chars"

# Storage Configuration (local | s3)
STORAGE_PROVIDER="local"

# S3 / Cloudflare R2 Configuration (required if STORAGE_PROVIDER="s3")
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="our-space-media"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"

